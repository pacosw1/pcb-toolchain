+fn board() -> BasicBoard {
+    let ls = LayerStructure::new(vec![Layer::new("F.Cu", true), Layer::new("B.Cu", true)]);
+    let matrix = ClearanceMatrix::get_default_instance(&ls, 200);
+    let mut rules = BoardRules::new(ls.clone(), matrix);
+    let class = rules.net_classes.append("default", &ls, false);
+    for name in ["a", "b", "c"] { rules.nets.add(name, 1, false, class); }
+    let padstacks = Padstacks::new(&ls);
+    let comm = Communication::new(Unit::Mil, 1, Some(SpecctraParserInfo::default()), CoordinateTransform::new(1.0, 0.0, 0.0), ItemIdGenerator::new());
+    BasicBoard::new(IntBox::new(-1000, -1000, 101000, 101000), ls,
+        vec![PolylineShape::Tile(TileShape::IntBox(IntBox::new(0, 0, 100000, 100000)))],
+        1, rules, BoardLibrary::new(padstacks, Packages::new()), Components::new(), comm)
+}
+fn segment(b: &mut BasicBoard, y: i32, net: i32) -> ItemKey {
+    b.insert_trace_without_cleaning(Polyline::from_int_points(&[
+        IntPoint::new(1000,y),IntPoint::new(5000,y)]),0,100,&[net],1,FixedState::Unfixed).unwrap()
+}
+#[test]
+fn identities_preserve_geometry_across_regenerated_ids_and_reject_replacement() {
+    let mut b=board(); segment(&mut b,1000,1); let second=segment(&mut b,1200,2);
+    let original=identities(&b); assert!(!original.is_empty());
+    b.remove_item(second); let replacement=segment(&mut b,1200,2);
+    assert_eq!(identities(&b),original,"generated item IDs must not define identity");
+    b.remove_item(replacement); segment(&mut b,1250,2);
+    let changed=identities(&b); assert_eq!(original.len(),changed.len());
+    assert!(!allowed(&original,&changed),"same-count displaced fault must reject");
+}
+#[test]
+fn new_geometry_and_changed_net_do_not_inherit_baseline_permission() {
+    let mut b=board(); segment(&mut b,1000,1); let second=segment(&mut b,1200,2);
+    let original=identities(&b); b.remove_item(second);
+    assert!(allowed(&original,&identities(&b)));
+    segment(&mut b,1200,3);
+    assert!(!allowed(&original,&identities(&b)));
+}
