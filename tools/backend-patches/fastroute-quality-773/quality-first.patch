+            board.communication.coordinate_transform.board_to_dsn_point(&item.center(board).to_float())
+        } else { [(bounds[0]+bounds[2])/2.,(bounds[1]+bounds[3])/2.] };
+        Self(format!("\"pristine_revision\":{},\"item_id\":{},\"kind\":{},\"ref\":{},\"pad\":{},\"nets\":[{}],\"layers\":[{}],\"dsn_center\":{:?},\"dsn_bounds\":{:?},\"dsn_unit\":{},\"dsn_resolution\":{}",
+            board.revision(),item.id().0,evidence_string(kind),evidence_string(&reference),
+            pad.as_deref().map(evidence_string).unwrap_or_else(||"null".into()),nets,layers,center,bounds,
+            evidence_string(&board.communication.unit.to_string()),board.communication.resolution))
+    }
