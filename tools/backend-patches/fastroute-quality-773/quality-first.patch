+fn bridge_board(other_y: i32) -> RoutingBoard {
+    let mut b=board();
+    let shapes=vec![Some(ConvexShape::Circle(Circle::new(IntPoint::new(0,0),600)));2];
+    let padstack=std::sync::Arc::make_mut(&mut b.library).padstacks.add("bridge",shapes,true,false);
+    b.insert_via(padstack,Point::Int(IntPoint::new(5000,4000)),&[1],1,FixedState::Unfixed,true);
+    b.insert_trace_without_cleaning(Polyline::from_int_points(&[
+        IntPoint::new(3000,4000),IntPoint::new(4500,4000)]),0,1200,&[1],1,FixedState::Unfixed).unwrap();
+    b.insert_trace_without_cleaning(Polyline::from_int_points(&[
+        IntPoint::new(5500,other_y),IntPoint::new(7000,other_y)]),0,100,&[2],1,FixedState::Unfixed).unwrap();
+    RoutingBoard::from_basic(b)
+}
+
+fn enhancements(b: &mut RoutingBoard) -> usize {
+    b.fallback_vias_own_class=true;
+    b.set_overlap_contacts(true);
+    b.bridge_trace_ends_to_drill_centers()
+}
+
+#[test]
+fn unsafe_bridge_rolls_back_entire_pre_enhancement_board_and_flags() {
+    use fr_engine::pipeline::quality::QualityGuard;
+    let mut b=bridge_board(5400);
+    let guard=QualityGuard::new(&b,&fr_settings::defaults::default_settings(2));
+    assert!(identities(&b).is_empty());
+    b.generate_snapshot(); // history must survive rollback as well as copper/settings
+    let expected=format!("{:?}",b);
+    let original=b.clone();
+    let mut unsafe_copy=b.clone();
+    assert!(enhancements(&mut unsafe_copy)>0);
+    assert!(!guard.accepts(&unsafe_copy),"fixture must create an actual new clearance identity");
+    let (accepted,n)=guard.enhance(&mut b,enhancements);
+    assert!(n>0); assert!(!accepted);
+    assert_eq!(format!("{:?}",b),expected,"restore whole board, search trees/history/flags included");
+    assert!(!b.fallback_vias_own_class);
+    let keys=b.get_traces();
+    b.translate_item(keys[0],&Vector::get_instance(0,9000));
+    std::sync::Arc::make_mut(&mut b.rules).nets.add("mutated",1,false,fr_engine::rules::NetClassId(0));
+    b.set_overlap_contacts(true);
+    assert_eq!(format!("{:?}",original),expected,"later candidate mutation cannot change accepted snapshot");
+    assert!(guard.accepts(&original));
+}
