+#[test]
+fn unsafe_checkpoint_cannot_replace_fallback_even_with_better_counts() {
+    use std::sync::{Arc,Mutex};
+    use std::sync::atomic::{AtomicUsize,Ordering};
+    use fr_engine::pipeline::{PipelineContext, CheckpointKey, quality::QualityGuard};
+    let mut basic=board(); segment(&mut basic,1000,1);
+    let baseline=RoutingBoard::from_basic(basic);
+    let settings=fr_settings::defaults::default_settings(2);
+    let guard=Arc::new(Mutex::new(QualityGuard::new(&baseline,&settings)));
+    let writes=Arc::new(AtomicUsize::new(0)); let observed=writes.clone();
+    let ctx=PipelineContext { quality:Some(guard), checkpoint:Some(Arc::new(move |_,_| {
+        observed.fetch_add(1,Ordering::SeqCst);
+    })),..Default::default() };
+    let mut unsafe_board=baseline.clone(); segment(&mut unsafe_board.basic,1200,2);
+    assert!(!ctx.quality_allows(&unsafe_board));
+    ctx.checkpoint(&unsafe_board,CheckpointKey { incomplete:0,violations:0,stage:1,score:99999. });
+    assert_eq!(writes.load(Ordering::SeqCst),0);
+    ctx.quality_restore(&mut unsafe_board);
+    assert_eq!(identities(&unsafe_board),identities(&baseline));
+    assert_eq!(unsafe_board.get_items().len(),baseline.get_items().len());
+}
