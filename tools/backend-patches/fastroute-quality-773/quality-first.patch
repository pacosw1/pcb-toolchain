+                net.map(|net|net.subnet_number.to_string()).unwrap_or_else(||"null".into()))
+        }).collect::<Vec<_>>().join(",");
+        let layers=(item.first_layer(board)..=item.last_layer(board)).map(|layer| {
+            board.layer_structure.layers.get(layer as usize).map(|l|evidence_string(&l.name)).unwrap_or_else(||"null".into())
