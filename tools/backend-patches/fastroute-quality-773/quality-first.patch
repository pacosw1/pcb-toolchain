+                ("pin",component.name.clone(),package.get_pin(pin.pin_index).map(|p|p.name.clone()))
+            },
+            _ => (if item.is_via(){"via"}else if item.is_trace(){"trace"}else{"other"},String::new(),None),
+        };
+        let nets=item.net_numbers().iter().map(|&n| {
+            let net=board.rules.nets.get(n);
