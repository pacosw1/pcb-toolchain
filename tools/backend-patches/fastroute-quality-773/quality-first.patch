new file mode 100644
index 0000000..479e754
--- /dev/null
+++ b/crates/fr-engine/src/pipeline/quality.rs
@@ -0,0 +1,101 @@
+//! Opt-in safety frontier: no new clearance identities relative to loaded DSN.
+//! Counts cannot distinguish removal of an old fault from introduction of a new one.
+use std::collections::BTreeSet;
+use crate::board::{BasicBoard, ItemKey, ItemKind, RoutingBoard};
+use super::{CheckpointKey, StatsCache};
+use fr_settings::RouterSettings;
+
+fn item_identity(board: &BasicBoard, key: ItemKey) -> String {
+    let item = board.item(key);
+    let kind = match &item.kind {
+        ItemKind::Pin(p) => format!("pin:{}:{}", item.component_no(), p.pin_index),
+        ItemKind::Via(_) => "via".into(),
+        ItemKind::Trace(_) => "trace".into(),
+        ItemKind::ObstacleArea(_) => "obstacle".into(),
+        ItemKind::ConductionArea(_) => "conduction".into(),
+        ItemKind::ComponentOutline(_) => "component-outline".into(),
+        ItemKind::BoardOutline(_) => "board-outline".into(),
+    };
+    // Actual shape content, not arena keys, generated item IDs or transient caches.
+    let shapes: Vec<_> = (0..board.tile_shape_count(key))
+        .map(|i| (board.shape_layer(key, i), format!("{:?}", board.tile_shape(key, i))))
+        .collect();
+    let nets: Vec<_> = item.net_numbers().iter().map(|&n| {
+        board.rules.nets.get(n).map_or_else(|| format!("unknown-net:{n}"),
+            |net| format!("{}:{}", net.name, net.subnet_number))
+    }).collect();
+    format!("{kind}|nets={nets:?}|class={}|shapes={shapes:?}", item.clearance_class())
+}
+
+pub fn identities(board: &BasicBoard) -> BTreeSet<String> {
+    crate::drc::all_clearance_violations(board).into_iter().map(|v| {
+        let mut pair = [item_identity(board, v.first_item), item_identity(board, v.second_item)];
+        pair.sort();
+        format!("{:?}|layer={}|required={:x}|actual={:x}|intersection={:?}",
+            pair, v.layer, v.expected_clearance.to_bits(), v.actual_clearance.to_bits(), v.shape)
+    }).collect()
+}
+
+pub fn allowed(baseline: &BTreeSet<String>, candidate: &BTreeSet<String>) -> bool {
+    candidate.is_subset(baseline)
+}
+
+pub struct QualityGuard {
+    baseline: BTreeSet<String>,
+    best: RoutingBoard,
+    key: CheckpointKey,
+}
+
+impl QualityGuard {
+    pub fn new(board: &RoutingBoard, settings: &RouterSettings) -> Self {
+        let score = StatsCache::new().score(board, settings);
+        Self { baseline: identities(board), best: board.clone(), key: CheckpointKey {
+            incomplete: score.incomplete_count, violations: score.clearance_violation_count,
+            stage: 0, score: score.router_score,
+        }}
+    }
+    pub fn accepts(&self, board: &RoutingBoard) -> bool {
+        allowed(&self.baseline, &identities(board))
+    }
+    /// Apply pre-routing enhancements against the ORIGINAL frontier. This is called
+    /// before an autoroute engine exists: Clone owns the item arena, search trees and
+    /// undo journal (shared rules/library use copy-on-write). Unlike deep_copy it
+    /// preserves revision, cached counts and history as well as both feature flags.
+    /// No rejected enhancement becomes the baseline or discards a safe imported SES.
+    pub fn enhance<T>(&self, board: &mut RoutingBoard, apply: impl FnOnce(&mut RoutingBoard) -> T) -> (bool, T) {
+        assert!(board.autoroute_engine.0.is_none(), "enhancement transaction requires no live autoroute engine");
+        let accepted_input = board.clone();
+        let result = apply(board);
+        let accepted = self.accepts(board);
+        if !accepted { *board = accepted_input; }
+        (accepted, result)
+    }
+    pub fn observe(&mut self, board: &RoutingBoard, key: CheckpointKey) -> bool {
+        if !self.accepts(board) { return false; }
+        if key.quality_better_than(&self.key) {
+            self.best = board.clone(); self.key = key;
+        }
+        true
+    }
+    pub fn best(&self) -> RoutingBoard { self.best.deep_copy() }
+}
