+//! Read-only actual-DSN identity cost and safe-session acceptance probe. No routing.
+use std::time::Instant;
+use fr_engine::pipeline::quality::QualityGuard;
+fn main() {
+    let args:Vec<_>=std::env::args().collect();
+    let bytes=std::fs::read(&args[1]).unwrap();
+    let mut settings=fr_settings::defaults::default_settings(2);
+    let mut board=fr_io::post_load::load_from_specctra_dsn(&bytes,&mut settings).unwrap();
+    fr_io::post_load::prepare_for_routing(&mut board,&mut settings,None);
+    let start=Instant::now();
+    let guard=QualityGuard::new(&board,&settings);
+    println!("baseline_create_ms={:.3}",start.elapsed().as_secs_f64()*1000.);
+    let start=Instant::now();
+    for _ in 0..5 { assert!(guard.accepts(&board)); }
+    println!("five_fresh_identity_checks_ms={:.3}",start.elapsed().as_secs_f64()*1000.);
+    let safe=fr_io::ses_writer::ses_bytes(&board,"safe-replay");
+    let mut imported=board.deep_copy();
+    let summary=fr_io::ses_reader::read_ses(&safe,&mut imported);
+    println!("safe_session_import={summary:?} accepted={}",guard.accepts(&imported));
+    assert!(guard.accepts(&imported),"safe exported session must not introduce a new identity");
+    if args.len()>2 { std::fs::write(&args[2],safe).unwrap(); }
+}
