+#[test]
+fn safe_bridge_is_retained_without_promoting_quality_baseline() {
+    use fr_engine::pipeline::quality::QualityGuard;
+    let mut b=bridge_board(7000);
+    let guard=QualityGuard::new(&b,&fr_settings::defaults::default_settings(2));
+    let original_geometry:Vec<_>=b.get_traces().iter().map(|k|format!("{:?}",b.item(*k).kind)).collect();
+    let (accepted,n)=guard.enhance(&mut b,enhancements);
+    assert!(accepted); assert!(n>0);
+    assert!(b.fallback_vias_own_class);
+    assert!(guard.accepts(&b));
+    let enhanced_geometry:Vec<_>=b.get_traces().iter().map(|k|format!("{:?}",b.item(*k).kind)).collect();
+    assert_ne!(enhanced_geometry,original_geometry,"bridge copper must be retained, including merged traces");
+    segment(&mut b.basic,4000,3);
+    assert!(!guard.accepts(&b),"safe enhancement must not grant later faults permission");
+}
