+#[test]
+fn baseline_and_observed_incumbent_are_isolated_from_later_mutation() {
+    use fr_engine::pipeline::{CheckpointKey, quality::QualityGuard};
+    let mut basic=board(); segment(&mut basic,1000,1); let second=segment(&mut basic,1200,2);
+    let mut source=RoutingBoard::from_basic(basic);
+    let expected=identities(&source);
+    let mut guard=QualityGuard::new(&source,&fr_settings::defaults::default_settings(2));
+    source.translate_item(second,&Vector::get_instance(0,3000));
+    source.assign_net_no(second,3);
+    assert_eq!(identities(&guard.best()),expected,"baseline clone must remain isolated");
+    source.remove_item(second);
+    assert!(guard.observe(&source,CheckpointKey { incomplete:0,violations:0,stage:1,score:100. }));
+    let retained_items=guard.best().get_items().len();
+    let remaining:Vec<_>=source.get_items().into_iter().filter(|k| source.item(*k).is_trace()).collect();
+    source.remove_items(remaining);
+    assert_eq!(guard.best().get_items().len(),retained_items,"observed incumbent must remain isolated");
+}
