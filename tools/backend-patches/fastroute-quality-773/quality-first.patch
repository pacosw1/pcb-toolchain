@@ -0,0 +1,83 @@
+use fr_engine::board::*;
+use fr_engine::datastructures::ItemIdGenerator;
+use fr_engine::ids::FixedState;
+use fr_engine::library::{BoardLibrary, Packages, Padstacks};
+use fr_engine::rules::{BoardRules, ClearanceMatrix};
+use fr_engine::structure::{Communication, Components, CoordinateTransform, Layer, LayerStructure, SpecctraParserInfo, Unit};
+use fr_engine::pipeline::quality::{identities, allowed};
+use fr_geom::*;
+
+fn board() -> BasicBoard {
+    let ls = LayerStructure::new(vec![Layer::new("F.Cu", true), Layer::new("B.Cu", true)]);
+    let matrix = ClearanceMatrix::get_default_instance(&ls, 200);
+    let mut rules = BoardRules::new(ls.clone(), matrix);
+    let class = rules.net_classes.append("default", &ls, false);
+    for name in ["a", "b", "c"] { rules.nets.add(name, 1, false, class); }
+    let padstacks = Padstacks::new(&ls);
+    let comm = Communication::new(Unit::Mil, 1, Some(SpecctraParserInfo::default()), CoordinateTransform::new(1.0, 0.0, 0.0), ItemIdGenerator::new());
+    BasicBoard::new(IntBox::new(-1000, -1000, 101000, 101000), ls,
+        vec![PolylineShape::Tile(TileShape::IntBox(IntBox::new(0, 0, 100000, 100000)))],
+        1, rules, BoardLibrary::new(padstacks, Packages::new()), Components::new(), comm)
+}
+fn segment(b: &mut BasicBoard, y: i32, net: i32) -> ItemKey {
+    b.insert_trace_without_cleaning(Polyline::from_int_points(&[
+        IntPoint::new(1000,y),IntPoint::new(5000,y)]),0,100,&[net],1,FixedState::Unfixed).unwrap()
+}
+#[test]
+fn identities_preserve_geometry_across_regenerated_ids_and_reject_replacement() {
+    let mut b=board(); segment(&mut b,1000,1); let second=segment(&mut b,1200,2);
+    let original=identities(&b); assert!(!original.is_empty());
+    b.remove_item(second); let replacement=segment(&mut b,1200,2);
+    assert_eq!(identities(&b),original,"generated item IDs must not define identity");
+    b.remove_item(replacement); segment(&mut b,1250,2);
+    let changed=identities(&b); assert_eq!(original.len(),changed.len());
+    assert!(!allowed(&original,&changed),"same-count displaced fault must reject");
+}
+#[test]
+fn new_geometry_and_changed_net_do_not_inherit_baseline_permission() {
+    let mut b=board(); segment(&mut b,1000,1); let second=segment(&mut b,1200,2);
+    let original=identities(&b); b.remove_item(second);
+    assert!(allowed(&original,&identities(&b)));
+    segment(&mut b,1200,3);
+    assert!(!allowed(&original,&identities(&b)));
+}
+
+#[test]
+fn unsafe_checkpoint_cannot_replace_fallback_even_with_better_counts() {
+    use std::sync::{Arc,Mutex};
+    use std::sync::atomic::{AtomicUsize,Ordering};
+    use fr_engine::pipeline::{PipelineContext, CheckpointKey, quality::QualityGuard};
+    let mut basic=board(); segment(&mut basic,1000,1);
+    let baseline=RoutingBoard::from_basic(basic);
+    let settings=fr_settings::defaults::default_settings(2);
+    let guard=Arc::new(Mutex::new(QualityGuard::new(&baseline,&settings)));
+    let writes=Arc::new(AtomicUsize::new(0)); let observed=writes.clone();
+    let ctx=PipelineContext { quality:Some(guard), checkpoint:Some(Arc::new(move |_,_| {
+        observed.fetch_add(1,Ordering::SeqCst);
+    })),..Default::default() };
+    let mut unsafe_board=baseline.clone(); segment(&mut unsafe_board.basic,1200,2);
+    assert!(!ctx.quality_allows(&unsafe_board));
+    ctx.checkpoint(&unsafe_board,CheckpointKey { incomplete:0,violations:0,stage:1,score:99999. });
+    assert_eq!(writes.load(Ordering::SeqCst),0);
+    ctx.quality_restore(&mut unsafe_board);
+    assert_eq!(identities(&unsafe_board),identities(&baseline));
+    assert_eq!(unsafe_board.get_items().len(),baseline.get_items().len());
+}
+
+#[test]
+fn baseline_and_observed_incumbent_are_isolated_from_later_mutation() {
+    use fr_engine::pipeline::{CheckpointKey, quality::QualityGuard};
+    let mut basic=board(); segment(&mut basic,1000,1); let second=segment(&mut basic,1200,2);
+    let mut source=RoutingBoard::from_basic(basic);
+    let expected=identities(&source);
+    let mut guard=QualityGuard::new(&source,&fr_settings::defaults::default_settings(2));
+    source.translate_item(second,&Vector::get_instance(0,3000));
+    source.assign_net_no(second,3);
+    assert_eq!(identities(&guard.best()),expected,"baseline clone must remain isolated");
+    source.remove_item(second);
+    assert!(guard.observe(&source,CheckpointKey { incomplete:0,violations:0,stage:1,score:100. }));
+    let retained_items=guard.best().get_items().len();
+    let remaining:Vec<_>=source.get_items().into_iter().filter(|k| source.item(*k).is_trace()).collect();
+    source.remove_items(remaining);
+    assert_eq!(guard.best().get_items().len(),retained_items,"observed incumbent must remain isolated");
+}
