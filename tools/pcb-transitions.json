{
  "schema": "iot-lab.transitions.v1",
  "groups": {
    "schematic": ["*.kicad_sch", "*.kicad_pro"],
    "board_shape": ["*.kicad_pcb#layers", "*.kicad_pcb#stackup", "*.kicad_pcb#outline", "*.kicad_dru"],
    "rules": ["placement-constraints.json", "reference-planes.json", "diff-pairs.json", "current-paths.json", "rf-lines.json", "gate.json"]
  },
  "states": [
    { "id": "A1", "name": "Requirements and spec", "status": "enforced", "evidence": "design_assessment", "next": ["A2"], "back": [],
      "inputs": [{ "name": "spec", "path": "hardware-design/boards/{board}/SPEC.md" }],
      "outputs": [{ "name": "design contract", "path": "hardware-design/registry/design-contracts/{board}.json" }] },
    { "id": "A2", "name": "Architecture", "status": "enforced", "evidence": "design_assessment", "next": ["A3"], "back": [], "gap": "architecture may be null, and the check then returns",
      "inputs": [{ "name": "interfaces, decisions, unknowns, test plans", "path": "hardware-design/registry/design-contracts/{board}.json" }],
      "outputs": [{ "name": "stage result in the assessment" }] },
    { "id": "A3", "name": "Part selection and part records", "status": "recorded", "evidence": "part_review", "next": ["A4"], "back": [], "gap": "a board with no bound manifest passes, and the report is JSON only",
      "inputs": [{ "name": "part-use manifest", "path": "hardware-design/registry/part-reviews/{board}.json" }, { "name": "datasheet PDFs with .source.json" }, { "name": "dated JLC evidence" }],
      "outputs": [{ "name": "part report" }, { "name": "selection ledger state electrically-selected" }] },
    { "id": "A4", "name": "Schematic", "status": "enforced", "evidence": "schematic", "next": ["A5"], "back": [], "gap": "no schematic image is made, and no person sees the schematic at a gate",
      "inputs": [{ "name": "schematic", "path": "{project}.kicad_sch" }, { "name": "project", "path": "{project}.kicad_pro" }, { "name": "schematic contract manifest" }],
      "outputs": [{ "name": "sealed schematic", "path": "hardware-design/boards/{board}/cad-seal.json" }, { "name": "ERC result" }, { "name": "schematic_sha256" }] },
    { "id": "A5", "name": "BOM", "status": "recorded", "evidence": "bom", "next": ["A6"], "back": [], "gap": "the CSV has no stage check, and next asks only for the file",
      "inputs": [{ "name": "verified BOM", "path": "hardware-design/boards/{board}/BOM-VERIFIED.csv" }, { "name": "BOM scope", "path": "hardware-design/boards/{board}/BOM-VERIFIED.scope.json" }, { "name": "registry BOM owner" }],
      "outputs": [{ "name": "coverage findings" }, { "name": "verified BOM", "path": "hardware-design/boards/{board}/BOM-VERIFIED.csv" }] },
    { "id": "A6", "name": "Stackup (planned, #1554)", "status": "implicit", "evidence": "stackup", "next": ["A7"], "back": [], "gap": "planned in #1554: no step asks for a layer count or layer roles",
      "inputs": [], "outputs": [] },
    { "id": "A7", "name": "Layout plan written", "status": "enforced", "evidence": "route_plan", "next": ["A8"], "back": [], "gap": "a new board has no run, so it has no image",
      "inputs": [{ "name": "intents" }, { "name": "route plan" }, { "name": "placement rules", "path": "hardware-design/boards/{board}/placement-constraints.json" }],
      "outputs": [{ "name": "layout plan", "path": "hardware-design/boards/{board}/layout-plan.json" }] },
    { "id": "A8", "name": "Layout plan approved (person gate)", "status": "enforced", "evidence": "layout_approval", "next": ["A9"], "back": [{ "to": "A7", "on": "layout_plan_stale" }, { "to": "A8", "on": "layout_plan_stale" }], "gap": "the image can be any file in the project, and --by is free text",
      "inputs": [{ "name": "name and reason" }, { "name": "image that the person saw" }],
      "outputs": [{ "name": "approval with hashes", "path": "hardware-design/boards/{board}/layout-plan.json" }, { "name": "approved image PNG", "path": "hardware-design/boards/{board}/layout-plan.png" }, { "name": "approved image SVG", "path": "hardware-design/boards/{board}/layout-plan.svg" }] },
    { "id": "A9", "name": "Placement seeds", "status": "enforced", "evidence": "placement", "next": ["A10"], "back": [{ "to": "A7", "on": "no_legal_candidate" }], "gap": "only a table: images exist only after a place edit",
      "inputs": [{ "name": "board", "path": "{project}.kicad_pcb" }, { "name": "--seeds N" }, { "name": "placement rules", "path": "hardware-design/boards/{board}/placement-constraints.json" }],
      "outputs": [{ "name": "one spec file per seed", "path": ".gate/place/{board}-seedN.json" }, { "name": "table with legality, misses and estimates" }] },
    { "id": "A10", "name": "Placement seed choice", "status": "enforced", "evidence": null, "next": ["A11"], "back": [],
      "inputs": [{ "name": "the table and the spec files" }],
      "outputs": [{ "name": "spec file passed to edit --kind place" }, { "name": "place table", "path": ".gate/place/{board}-candidates.json" }] },
    { "id": "A11", "name": "Place edit (candidate run)", "status": "enforced", "evidence": "placement", "next": ["A12", "A18", "A19"], "back": [{ "to": "A9", "on": "gate_finding" }, { "to": "A10", "on": "gate_finding" }],
      "inputs": [{ "name": "place spec" }, { "name": "optional part review" }],
      "outputs": [{ "name": "source record", "path": "{run}/operation/source.json" }, { "name": "top image", "path": "{run}/images/top.svg" }, { "name": "bottom image", "path": "{run}/images/bottom.svg" }] },
    { "id": "A12", "name": "Board placed check (before route)", "status": "enforced", "evidence": "placement", "next": ["A13"], "back": [{ "to": "A9", "on": "board_unplaced" }],
      "inputs": [{ "name": "board", "path": "{project}.kicad_pcb" }, { "name": "placement rules", "path": "hardware-design/boards/{board}/placement-constraints.json" }],
      "outputs": [{ "name": "placement rules report", "path": "{run}/operation/placement-rules-preflight.json" }] },
    { "id": "A13", "name": "RF route", "status": "recorded", "evidence": "copper", "next": ["A14"], "back": [{ "to": "A11", "on": "rf_failures" }], "gap": "no RF stage in STAGE_CONTRACTS, and no image shows the RF copper alone",
      "inputs": [{ "name": "route plan stage for RF nets" }, { "name": "RF lines", "path": "hardware-design/boards/{board}/rf-lines.json" }],
      "outputs": [{ "name": "RF copper in a candidate" }, { "name": "rf check result" }] },
    { "id": "A14", "name": "Staged route", "status": "enforced", "evidence": "copper", "next": ["A15", "A17", "A18"], "back": [], "gap": "a stuck run has stuck.json, and images are not required",
      "inputs": [{ "name": "route stages, a policy or an explicit spec" }],
      "outputs": [{ "name": "routed candidate" }, { "name": "stuck report", "path": "{run}/operation/stuck.json" }, { "name": "top image", "path": "{run}/images/top.svg" }, { "name": "bottom image", "path": "{run}/images/bottom.svg" }] },
    { "id": "A15", "name": "Route stuck and decision", "status": "enforced", "evidence": null, "next": ["A16"], "back": [{ "to": "A14", "on": "route_stuck" }, { "to": "A11", "on": "route_stuck" }], "gap": "the answer to ask_user has no field",
      "inputs": [{ "name": "stuck report", "path": "{run}/operation/stuck.json" }, { "name": "reviewed rules" }, { "name": "a recorded move" }],
      "outputs": [{ "name": "route decision" }] },
    { "id": "A16", "name": "Diagnose and repair", "status": "enforced", "evidence": null, "next": ["A18"], "back": [],
      "inputs": [{ "name": "diagnosis" }, { "name": "repair plan" }, { "name": "optional --from-run" }],
      "outputs": [{ "name": "repair candidate" }, { "name": "top image", "path": "{run}/images/top.svg" }, { "name": "bottom image", "path": "{run}/images/bottom.svg" }] },
    { "id": "A17", "name": "Finishing edits (stitching, silk, test points, courtyards)", "status": "recorded", "evidence": null, "next": ["A18"], "back": [], "gap": "no stage, no run record and no image: only the seal line",
      "inputs": [{ "name": "routed board", "path": "{project}.kicad_pcb" }, { "name": "options such as --skip, --via, --through-pours" }],
      "outputs": [{ "name": "edited board", "path": "{project}.kicad_pcb" }, { "name": "seal log line", "path": ".gate/cad-seal/{board}.jsonl" }, { "name": "stitch report" }] },
    { "id": "A18", "name": "Gate (G3, G4, G5)", "status": "enforced", "evidence": "gate", "next": ["A19", "A20", "A21"], "back": [{ "to": "A4", "on": "gate_finding" }, { "to": "A9", "on": "gate_finding" }, { "to": "A14", "on": "gate_finding" }, { "to": "A16", "on": "gate_finding" }], "gap": "a check run has no image",
      "inputs": [{ "name": "board CAD", "path": "{project}.kicad_pcb" }, { "name": "gate configuration", "path": "hardware-design/boards/{board}/gate.json" }, { "name": "check data files" }],
      "outputs": [{ "name": "gate result", "path": "{run}/gate/result.json" }, { "name": "findings", "path": "{run}/gate/findings.json" }, { "name": "ERC report", "path": "{run}/gate/erc.json" }, { "name": "DRC report", "path": "{run}/gate/drc.json" }] },
    { "id": "A19", "name": "Adopt", "status": "enforced", "evidence": null, "next": ["A21"], "back": [{ "to": "A12", "on": "adopted" }],
      "inputs": [{ "name": "candidate run" }, { "name": "--baseline and --defect for a frozen board" }],
      "outputs": [{ "name": "canonical PCB", "path": "{project}.kicad_pcb" }, { "name": "backup" }, { "name": "adoption record", "path": "{run}/adoption.json" }, { "name": "new seal", "path": "hardware-design/boards/{board}/cad-seal.json" }] },
    { "id": "A20", "name": "Build (pipeline)", "status": "enforced", "evidence": null, "next": [], "back": [{ "to": "A18", "on": "built" }],
      "inputs": [{ "name": "pipeline script of gate.json", "path": "hardware-design/boards/{board}/gate.json" }],
      "outputs": [{ "name": "candidate" }, { "name": "top image", "path": "{run}/images/top.svg" }, { "name": "bottom image", "path": "{run}/images/bottom.svg" }] },
    { "id": "A21", "name": "Release candidate", "status": "enforced", "evidence": "release", "next": ["A22", "A23"], "back": [],
      "inputs": [{ "name": "board", "path": "{project}.kicad_pcb" }, { "name": "release recipe", "path": "hardware-design/boards/{board}/gate.json" }],
      "outputs": [{ "name": "staged Gerber, BOM and CPL" }, { "name": "release manifest" }, { "name": "file VERIFIED" }] },
    { "id": "A22", "name": "Release approval G5 (person gate)", "status": "recorded", "evidence": "release_approval", "next": ["A23"], "back": [], "gap": "D1: --by is free text",
      "inputs": [{ "name": "a person reviews the candidate" }, { "name": "readiness report" }, { "name": "the image that the person saw" }],
      "outputs": [{ "name": "release approval", "path": "hardware-design/boards/{board}/release-approval.json" }, { "name": "kept readiness report", "path": "hardware-design/boards/{board}/release-approval.report.json" }, { "name": "release log", "path": ".gate/release-approval/{board}.jsonl" }] },
    { "id": "A23", "name": "Readiness (stock, assembly, orientation)", "status": "recorded", "evidence": "readiness", "next": ["A24"], "back": [], "gap": "no later step reads the report",
      "inputs": [{ "name": "candidate folder" }, { "name": "stock receipt" }, { "name": "--boards" }],
      "outputs": [{ "name": "readiness report" }] },
    { "id": "A24", "name": "Fabrication order and assembly", "status": "recorded", "evidence": "order", "next": ["A25"], "back": [], "gap": "a person writes the record after the order, --by is free text, and no record shows assembled boards",
      "inputs": [{ "name": "release candidate" }, { "name": "release approval", "path": "hardware-design/boards/{board}/release-approval.json" }, { "name": "JLC submission notes", "path": "hardware-design/boards/{board}/JLC-SUBMISSION.md" }],
      "outputs": [{ "name": "release orders", "path": "hardware-design/boards/{board}/release-orders.jsonl" }, { "name": "release log", "path": ".gate/release-approval/{board}.jsonl" }, { "name": "ordered boards" }, { "name": "assembled boards" }] },
    { "id": "A25", "name": "Bring-up", "status": "recorded", "evidence": "bringup", "next": [], "back": [], "gap": "bench data is not needed before a release, and a failure has no link back",
      "inputs": [{ "name": "test plan", "path": "hardware-design/boards/{board}/BRINGUP-TEST-PLAN.md" }, { "name": "raw measured data" }, { "name": "instruments" }, { "name": "board serial" }],
      "outputs": [{ "name": "bench receipt" }, { "name": "block level 2" }] },

    { "id": "B1", "name": "Exemption (design_contract_exempt, layout_plan_exempt)", "status": "recorded", "evidence": null, "next": [], "back": [], "gap": "nothing reads the events",
      "inputs": [{ "name": "free text reason", "path": "hardware-design/registry/boards.json" }],
      "outputs": [{ "name": "event design.exempt or layout_plan.exempt" }] },
    { "id": "B2", "name": "Board lifecycle (planned, active, historical, obsolete)", "status": "recorded", "evidence": null, "next": [], "back": [],
      "inputs": [{ "name": "registry", "path": "hardware-design/registry/boards.json" }],
      "outputs": [{ "name": "packet and layout rules by lifecycle" }] },
    { "id": "B3", "name": "CAD seal (sealed, changed, missing, not_canonical)", "status": "enforced", "evidence": "schematic", "next": [], "back": [],
      "inputs": [{ "name": "board", "path": "{project}.kicad_pcb" }, { "name": "schematic", "path": "{project}.kicad_sch" }, { "name": "project", "path": "{project}.kicad_pro" }, { "name": "design rules", "path": "{project}.kicad_dru" }, { "name": "placement rules", "path": "hardware-design/boards/{board}/placement-constraints.json" }],
      "outputs": [{ "name": "seal", "path": "hardware-design/boards/{board}/cad-seal.json" }, { "name": "seal log", "path": ".gate/cad-seal/{board}.jsonl" }] },
    { "id": "B4", "name": "Seal accept (person gate)", "status": "enforced", "evidence": null, "next": ["B3"], "back": [], "gap": "the accept shows no diff, and the log is local",
      "inputs": [{ "name": "--accept --reason TEXT" }],
      "outputs": [{ "name": "new seal", "path": "hardware-design/boards/{board}/cad-seal.json" }, { "name": "reason in the log", "path": ".gate/cad-seal/{board}.jsonl" }] },
    { "id": "B5", "name": "Placement rules (placement-constraints.json)", "status": "enforced", "evidence": "rules", "next": ["A7"], "back": [],
      "inputs": [{ "name": "pcb constraints --add SPEC --reason TEXT, or --remove ID" }],
      "outputs": [{ "name": "rules file", "path": "hardware-design/boards/{board}/placement-constraints.json" }, { "name": "seal line with the reason", "path": ".gate/cad-seal/{board}.jsonl" }] },
    { "id": "B6", "name": "Run status", "status": "enforced", "evidence": null, "next": [], "back": [],
      "inputs": [{ "name": "the owned supervisor" }],
      "outputs": [{ "name": "run state", "path": "{run}/state.json" }, { "name": "sealed result", "path": "{run}/result.json" }] },
    { "id": "B7", "name": "Stage contract (source record and two images)", "status": "enforced", "evidence": null, "next": [], "back": [],
      "inputs": [{ "name": "source record", "path": "{run}/operation/source.json" }, { "name": "top image", "path": "{run}/images/top.svg" }, { "name": "bottom image", "path": "{run}/images/bottom.svg" }],
      "outputs": [{ "name": "run sealed as error when a file is missing" }] },
    { "id": "B8", "name": "Candidate action (iot-lab.candidate-action.v1)", "status": "enforced", "evidence": null, "next": [], "back": [],
      "inputs": [{ "name": "request of edit, route or repair" }],
      "outputs": [{ "name": "action record", "path": "{run}/run.json" }] },
    { "id": "B9", "name": "Adoption journal (intent, replaced, receipt)", "status": "enforced", "evidence": null, "next": ["A19"], "back": [],
      "inputs": [{ "name": "candidate hashes, target hash" }],
      "outputs": [{ "name": "journal", "path": ".gate/board-locks/{board}.adoption.json" }, { "name": "adoption record", "path": "{run}/adoption.json" }] },
    { "id": "B10", "name": "Routing loop round (experimental)", "status": "enforced", "evidence": null, "next": ["A14"], "back": [],
      "inputs": [{ "name": "loop context" }],
      "outputs": [{ "name": "one route run per round" }] },
    { "id": "B11", "name": "Engineering cycle (open, recorded)", "status": "recorded", "evidence": null, "next": [], "back": [],
      "inputs": [{ "name": "pcb cycle start, activities, attached runs" }],
      "outputs": [{ "name": "cycle record with timings" }] },
    { "id": "B12", "name": "Production evidence (contract stage)", "status": "recorded", "evidence": null, "next": [], "back": [],
      "inputs": [{ "name": "sourced applicability of assembly, test coverage, yield" }],
      "outputs": [{ "name": "a blocked stage" }] },
    { "id": "B13", "name": "Agent trial (run.pending.json then run.json)", "status": "enforced", "evidence": null, "next": [], "back": [],
      "inputs": [{ "name": "a trial case" }],
      "outputs": [{ "name": "run.json or a settled crash record" }] },
    { "id": "B14", "name": "Frozen board", "status": "enforced", "evidence": null, "next": ["A19"], "back": [], "gap": "D10: the FOCUS.md list is not compared with the registry",
      "inputs": [{ "name": "registry row", "path": "hardware-design/registry/boards.json" }, { "name": "unfreeze record", "path": "hardware-design/boards/{board}/unfreeze.json" }, { "name": "FOCUS.md text", "path": "FOCUS.md" }],
      "outputs": [{ "name": "a stop of each CAD write" }, { "name": "frozen true in context" }] },
    { "id": "B15", "name": "Person approval (who approves)", "status": "implicit", "evidence": null, "next": ["A8", "B4", "B5"], "back": [], "gap": "D1: --by is any text",
      "inputs": [{ "name": "--by NAME" }],
      "outputs": [{ "name": "the name in the approval" }] },
    { "id": "B16", "name": "Gate configuration and check data files", "status": "enforced", "evidence": "rules", "next": ["A18"], "back": [], "gap": "D2: the stage can still go down, because no up-only rule exists",
      "inputs": [{ "name": "gate configuration", "path": "hardware-design/boards/{board}/gate.json" }, { "name": "reference planes", "path": "hardware-design/boards/{board}/reference-planes.json" }, { "name": "differential pairs", "path": "hardware-design/boards/{board}/diff-pairs.json" }, { "name": "current paths", "path": "hardware-design/boards/{board}/current-paths.json" }, { "name": "RF lines", "path": "hardware-design/boards/{board}/rf-lines.json" }],
      "outputs": [] },
    { "id": "B17", "name": "Route environment settings", "status": "enforced", "evidence": null, "next": ["A14"], "back": [], "gap": "a direct tool call still reads the environment, and no run record keeps it",
      "inputs": [{ "name": "route features", "path": "tools/route-features.json" }, { "name": "route_features of the board", "path": "hardware-design/boards/{board}/gate.json" }],
      "outputs": [] },
    { "id": "B18", "name": "Route dispatch fallback", "status": "enforced", "evidence": null, "next": ["A14"], "back": [],
      "inputs": [{ "name": "exit code of the client" }],
      "outputs": [{ "name": "a local route" }] }
  ],
  "kinds": [
    { "id": "part_swap_new_footprint", "doc": "T2", "role": "change", "group": "schematic", "reenter": ["A3"],
      "redo": ["part_review", "schematic", "bom", "rules", "route_plan", "layout_approval", "placement", "copper", "gate", "release", "readiness"],
      "keep": ["design_assessment", "stackup"], "approve": ["part_review", "layout_approval"] },
    { "id": "part_swap_same_footprint", "doc": "T1", "role": "change", "group": "schematic", "reenter": ["A3"],
      "redo": ["part_review", "bom", "layout_approval", "gate", "release", "readiness"],
      "keep": ["placement", "copper", "rules", "route_plan"], "approve": ["part_review", "layout_approval"] },
    { "id": "part_value_change", "doc": "T3", "role": "change", "group": "schematic", "reenter": ["A3"],
      "redo": ["part_review", "bom", "layout_approval", "gate", "release", "readiness"],
      "keep": ["placement", "copper", "rules", "route_plan"], "approve": ["part_review"] },
    { "id": "net_change", "doc": "T4", "role": "change", "group": "schematic", "reenter": ["A4"],
      "redo": ["schematic", "route_plan", "layout_approval", "copper", "gate", "release", "readiness"],
      "keep": ["part_review", "bom", "placement"], "approve": ["layout_approval"] },
    { "id": "stackup_change", "doc": "T7", "role": "change", "group": "board_shape", "reenter": ["A6"],
      "redo": ["stackup", "route_plan", "layout_approval", "placement", "copper", "gate", "release", "readiness"],
      "keep": ["part_review", "schematic", "bom"], "approve": ["layout_approval"] },
    { "id": "outline_change", "doc": "T8", "role": "change", "group": "board_shape", "reenter": ["A7"],
      "redo": ["layout_approval", "placement", "copper", "gate", "release", "readiness"],
      "keep": ["design_assessment", "part_review", "schematic", "bom", "stackup", "route_plan"], "approve": ["layout_approval"] },
    { "id": "design_rule_change", "doc": "T9", "role": "change", "group": "board_shape", "reenter": ["A7"],
      "redo": ["layout_approval", "placement", "copper", "gate", "release", "readiness"],
      "keep": ["design_assessment", "part_review", "schematic", "bom", "stackup"], "approve": ["layout_approval"] },
    { "id": "rule_change", "doc": "T9", "role": "change", "group": "rules", "reenter": ["A7"],
      "redo": ["rules", "layout_approval", "placement", "copper", "gate", "release", "readiness"],
      "keep": ["design_assessment", "part_review", "schematic", "bom", "stackup"], "approve": ["layout_approval"] },
    { "id": "route_plan_change", "doc": "T10", "role": "change", "group": null, "reenter": ["A7"],
      "redo": ["route_plan", "layout_approval", "copper", "gate", "release", "readiness"],
      "keep": ["design_assessment", "part_review", "schematic", "bom", "placement"], "approve": ["layout_approval"] },
    { "id": "datasheet_change", "doc": "T5", "role": "change", "group": null, "reenter": ["A3"],
      "redo": ["part_review"],
      "keep": ["design_assessment"], "approve": ["part_review"] },
    { "id": "out_of_stock", "doc": "T6", "role": "change", "group": null, "reenter": ["A3"],
      "redo": ["readiness"],
      "keep": ["schematic", "bom", "layout_approval", "placement", "copper", "gate", "release"], "approve": ["substitute_choice"] },
    { "id": "approval_withdrawn", "doc": "T11", "role": "change", "group": null, "reenter": ["A8"],
      "redo": ["layout_approval", "placement", "copper", "gate", "release", "readiness"],
      "keep": ["design_assessment", "part_review", "schematic", "bom", "route_plan", "rules"], "approve": ["layout_approval"] },
    { "id": "route_stuck", "doc": "T12", "role": "change", "group": null, "reenter": ["A15"],
      "redo": ["copper"],
      "keep": ["design_assessment", "part_review", "schematic", "bom", "rules", "route_plan", "layout_approval", "placement"], "approve": ["route_move"] },
    { "id": "gate_failed", "doc": "T13", "role": "change", "group": null, "reenter": ["A4", "A9", "A14"],
      "redo": ["gate", "release", "readiness"],
      "keep": ["design_assessment"], "approve": [] },
    { "id": "drc_failed", "doc": "T14", "role": "change", "group": null, "reenter": ["A4", "A9", "A14", "A16"],
