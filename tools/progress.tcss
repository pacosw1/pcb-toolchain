Screen { background: #101619; color: #d6e0e4; }
#masthead { height: 3; padding: 1 2 0 2; background: #182125; border-bottom: solid #34434a; }
#brand { width: 1fr; color: #ecc39d; }
#connection { width: 28; text-align: right; }
#workspace { height: 1fr; }
#sidebar { width: 31; padding: 1; background: #141d21; border-right: solid #304049; }
.eyebrow { color: #8198a3; text-style: bold; margin: 1 0; }
.board-card { height: 8; padding: 0 1; margin-bottom: 1; border: round #304149; background: #192328; }
.board-card.selected { border: round #b18962; background: #2a2924; }
.board-card:focus { border: round #ebbc91; }
#sidebar-help { color: #6b8792; height: auto; margin: 1 1; }
#detail { padding: 1 2; }
#selection { height: 2; text-style: bold; color: #f1ede5; }
#freshness { height: 1; color: #bfa68a; }
#metrics { height: 3; }
.metric { width: 1fr; height: 3; border: round #35464e; padding: 0 1; margin-right: 1; content-align: center middle; background: #182226; }
#view-toolbar, #view-options { height: 3; }
#view-toolbar Button { min-width: 10; width: auto; margin-right: 1; background: #202e34; border: tall #2f454e; }
#view-toolbar Button.active-view { background: #40342a; color: #f1bd8c; border: tall #8e6c4b; }
#view-options Button { min-width: 5; width: auto; padding: 0 1; margin-right: 1; }
#view-options Select { width: 21; margin-right: 1; }
#render-status { width: 1fr; padding: 1; color: #c3a886; }
#visual-stage { height: 1fr; min-height: 8; border: round #3b5058; background: #12191d; align: center middle; }
#board-image { width: auto; height: 100%; max-width: 100%; }
#visual-empty { width: 100%; height: 100%; content-align: center middle; color: #94acb7; layer: overlay; }
#source-caption { height: 1; color: #7c99a4; }
#details-tabs { height: 10; }
TabPane { padding: 0 1; }
Tabs { background: #192328; }
Tab.-active { color: #f0bd91; background: #302b25; }
Underline > .underline--bar { color: #d9ac83; }
#task { height: auto; padding: 1; background: #222c2f; border-left: thick #8bb7a6; margin-bottom: 1; }
#observed { height: auto; color: #a4bac4; margin-bottom: 1; }
#check-status { height: auto; color: #8eb29f; margin-bottom: 1; }
#changed-files, #commits, #trend { height: auto; padding: 1 0; color: #bdcbd1; }
#footnote { height: 2; color: #637d89; padding-top: 1; }
Footer { background: #223037; color: #a9c0cb; }
Footer > .footer--key { background: #35474e; color: #efc59c; }
.compact #sidebar { width: 25; }
.compact .board-card { height: 6; }
.compact #detail { padding: 0 1; }
.compact #selection { height: 1; }
.compact #metrics, .compact #freshness, .compact #footnote { display: none; }
.compact #view-toolbar Button { min-width: 6; padding: 0 1; margin-right: 0; }
.compact #view-options Select { width: 18; }
.compact #details-tabs { display: none; }
.compact.show-details #details-tabs { display: block; height: 1fr; }
.compact.show-details #visual-stage { display: none; }
