#!/bin/sh
# Repository-local dispatcher. Native operations use Node; remaining operations use the legacy CLI.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
case "${1:-}" in
  --project) command=${3:-} ;;
  --project=*) command=${2:-} ;;
  *) command=${1:-} ;;
esac
case "$command" in
  protected) exec node --experimental-strip-types --no-warnings "$here/pcb-protected.mts" "$@" ;;
  list|context|next|status|events|explain|cancel|note|benchmark) exec node --experimental-strip-types --no-warnings "$here/pcb-observe.ts" "$@" ;;
  check|doctor|readiness|blocks|outcomes|schematic) exec node --experimental-strip-types --no-warnings "$here/pcb-check.ts" "$@" ;;
esac
exec python3 "$here/pcb-python.py" "$@"
