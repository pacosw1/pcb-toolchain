#!/bin/sh
# Repository-local dispatcher: tools/pcb [--project DIR] COMMAND ...
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
case "${1:-}" in
  --project) command=${3:-} ;;
  --project=*) command=${2:-} ;;
  *) command=${1:-} ;;
esac
case "$command" in
  loop) exec node --experimental-strip-types --no-warnings "$here/pcb-loop.ts" "$@" ;;
  list|context|next|status|events|explain|cancel|note|benchmark|cycle|adopt|seal) exec node --experimental-strip-types --no-warnings "$here/pcb-observe.ts" "$@" ;;
  bench) exec node --experimental-strip-types --no-warnings "$here/bench.ts" "$@" ;;
  constraints) exec node --experimental-strip-types --no-warnings "$here/pcb-constraints.ts" "$@" ;;
  release-approval|release-order) exec node --experimental-strip-types --no-warnings "$here/pcb-release-record.ts" "$@" ;;
  layout) exec node --experimental-strip-types --no-warnings "$here/pcb-layout.ts" "$@" ;;
  place) exec node --experimental-strip-types --no-warnings "$here/pcb-place.ts" "$@" ;;
  trial) exec node --experimental-strip-types --no-warnings "$here/agent-trial.ts" "$@" ;;
  project-check) exec node --experimental-strip-types --no-warnings "$here/pcb-project-check.ts" "$@" ;;
esac
exec node --experimental-strip-types --no-warnings "$here/pcb-check.ts" "$@"
