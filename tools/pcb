#!/bin/sh
# Repository-local dispatcher: tools/pcb [--project DIR] COMMAND ...
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
case "${1:-}" in
  --project) command=${3:-} ;;
  --project=*) command=${2:-} ;;
  *) command=${1:-} ;;
esac
case "$command" in
  protected) exec node --experimental-strip-types --no-warnings "$here/pcb-protected.mts" "$@" ;;
  list|context|next|status|events|explain|cancel|note|benchmark|cycle|adopt) exec node --experimental-strip-types --no-warnings "$here/pcb-observe.ts" "$@" ;;
esac
exec node --experimental-strip-types --no-warnings "$here/pcb-check.ts" "$@"
