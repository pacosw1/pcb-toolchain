# Copy to /etc/pcb-job-daemon.env (mode 600). README "Defaults" explains each value.
JOBD_BIND=100.93.34.43
JOBD_PORT=8793
JOBD_TOKEN_FILE=/etc/pcb-job-daemon.token
# On md4 (1.1 TB free). The root disk has 12 GB free and is shared.
JOBD_DATA_DIR=/var/lib/docker/pcb-jobs
JOBD_CGROUP_PARENT=pcbjobs.slice
JOBD_CPU_BUDGET=16
JOBD_MEM_BUDGET_GB=32
