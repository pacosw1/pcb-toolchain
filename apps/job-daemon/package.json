{
  "name": "pcb-job-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote placer and router jobs on the Linux box. No runtime dependencies; dev dependencies are for the type check.",
  "bin": { "pcb-job": "src/client.ts" },
  "engines": { "node": ">=22.13" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test --test-timeout=60000 test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
