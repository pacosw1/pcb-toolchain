#!/bin/sh
# pcb launcher of an installed pcb-toolchain bundle: find the project, check its toolchain.lock, run tools/pcb.
set -eu
self=$(dirname "$(realpath "$0")")   # follow the ~/.local/bin/pcb symlink to the installed bundle
bundle=$(cd "$self/.." && pwd -P)
version=$(sed -n '1p' "$bundle/VERSION" 2>/dev/null | cut -d' ' -f1)

project=''
sync_only=''
prev=''
for a in "$@"; do                                   # --project DIR (or --project=DIR) anywhere in the arguments
  case "$prev" in --project) project=$a ;; *) [ "$a" = toolchain-sync ] && sync_only=1 ;; esac
  case "$a" in --project=*) project=${a#--project=} ;; esac
  prev=$a
done
if [ -z "$project" ] && [ -n "${IOT_LAB:-}" ]; then project=$IOT_LAB; fi
if [ -z "$project" ]; then
  d=$(pwd -P)
  while [ "$d" != / ]; do
    if [ -d "$d/hardware-design/boards" ]; then project=$d; break; fi
    d=$(dirname "$d")
  done
fi
[ -n "$project" ] || { echo "pcb: no project (use --project DIR, IOT_LAB, or run inside a project)" >&2; exit 2; }

lock="$project/toolchain.lock"
live_registered=1
if [ -z "${PCB_LIVE_GUARD_ACTIVE:-}" ] && [ -f "$bundle/tools/pcb-live-guard.mts" ]; then
  if node --no-warnings --experimental-strip-types "$bundle/tools/pcb-live-guard.mts" --registered "$project"; then live_registered=0
  else live_registered=$?; fi
  [ "$live_registered" -le 1 ] || { echo 'pcb: cannot verify live coordination configuration' >&2; exit 2; }
fi
delegate=''
if [ "$live_registered" = 0 ] && [ ! -f "$lock" ]; then delegate="$project/tools/pcb"; fi
if [ -f "$lock" ]; then
  want=$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1])).version' "$lock")
  other="${HOME}/.local/share/pcb-toolchain/$want/bin/pcb"
  if [ "$live_registered" = 0 ] && [ "$want" != "$version" ]; then
    [ -x "$other" ] || { echo "pcb: project pins $want; install it before running" >&2; exit 2; }
    delegate=$other
  fi
  if [ "$live_registered" != 0 ] && [ "$want" != "$version" ] && [ -x "$other" ] && [ "${PCB_ALLOW_VERSION_MISMATCH:-}" != 1 ]; then
    exec "$other" "$@"                              # the installed release that this project pins
  fi
  if [ "$live_registered" != 0 ] && [ "$want" != "$version" ] && [ "${PCB_ALLOW_VERSION_MISMATCH:-}" != 1 ]; then
    echo "pcb: project $project pins pcb-toolchain $want, this is $version (scripts/install.sh $want)" >&2
    exit 2
  fi
fi

envf="$project/.pcb-toolchain.env"                # project settings: KEY=VALUE lines (REMOTE_HOST, PCB_LIVE_BIND, PCB_LIVE_HOST)
if [ -f "$envf" ]; then
  while IFS='=' read -r k v; do
    case "$k" in ''|\#*) continue ;; esac
    case "$k" in *[!A-Za-z0-9_]*) echo "pcb: bad key '$k' in $envf" >&2; exit 2 ;; esac
    eval "cur=\${$k:-}"
    [ -n "$cur" ] || export "$k=$v"                 # the caller's environment wins
  done < "$envf"
fi

if [ -n "$delegate" ]; then
  [ -x "$delegate" ] || { echo "pcb: project toolchain is not executable: $delegate" >&2; exit 2; }
  if [ -f "$lock" ]; then node --no-warnings --experimental-strip-types "$bundle/tools/pcb-live-guard.mts" --check-managed "$project" || exit $?; fi
  export IOT_LAB="$project" PCB_LIVE_GUARD_ACTIVE=1
  exec node --no-warnings --experimental-strip-types "$bundle/tools/pcb-live-guard.mts" --project "$project" -- "$delegate" "$@"
fi
export IOT_LAB="$project" PCB_TOOLCHAIN_ROOT="$bundle" PCB_TOOLCHAIN_VERSION="$version"
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) export IOTROUTE_BIN="$bundle/bin/iotroute-darwin-arm64" ;;
  Linux-x86_64) export IOTROUTE_BIN="$bundle/bin/iotroute-linux-x86_64" ;;
esac
if [ -f "$bundle/VERSION" ] && [ -f "$lock" ] && [ "$project" != "$bundle" ]; then   # pinned: release tools/ into the project (read-only)
  if [ "$live_registered" = 0 ]; then export PCB_LIVE_SAFE_SYNC=1; fi
  node "$bundle/bin/toolchain_sync.mjs" "$project" || exit $?
fi
[ -z "$sync_only" ] || exit 0
if [ "$live_registered" = 0 ]; then
  exec node --no-warnings --experimental-strip-types "$bundle/tools/pcb-live-guard.mts" --project "$project" -- python3 "$bundle/tools/pcb" "$@"
fi
exec python3 "$bundle/tools/pcb" "$@"
