{
  "version": "0",
  "name": "pcb-toolchain",
  "stages": [
    {
      "name": "verify",
      "queueSafe": true,
      "reuseQueueRun": true,
      "jobs": [
        {
          "name": "tools-unit",
          "image": "iot-lab-ci:node22-python3-numpy-v2",
          "user": "daemon",
          "env": {"HOME": "/tmp", "IOT_CPU_BUDGET": "2", "OPENBLAS_NUM_THREADS": "1", "OMP_NUM_THREADS": "1"},
          "steps": [{"run": "node --test scripts/test-toolchain-sync.mjs"}, {"run": "node --experimental-strip-types --no-warnings --test apps/studio/app/test/*.test.ts"}, {"run": "sh .cip/run-unit.sh"}],
          "limits": {"timeoutSec": 900, "cpus": 2, "memoryMb": 2048}
        },
        {
          "name": "iotroute",
          "image": "rust:1.93.1",
          "steps": [{"run": "cd tools/router/core && cargo test --release --locked --quiet"}],
          "limits": {"timeoutSec": 600, "cpus": 4, "memoryMb": 4096}
        }
      ]
    }
  ]
}
