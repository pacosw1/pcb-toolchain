{
  "version": "0",
  "name": "pcb-toolchain",
  "stages": [
    {
      "name": "verify",
      "queueSafe": true,
      "reuseQueueRun": true,
      "jobs": [
        {
          "name": "tools-unit",
          "image": "iot-lab-ci:node22-python3-numpy-v2",
          "user": "daemon",
          "env": {
            "HOME": "/tmp",
            "IOT_CPU_BUDGET": "2",
            "OPENBLAS_NUM_THREADS": "1",
            "OMP_NUM_THREADS": "1"
          },
          "steps": [
            {
              "run": "node --test scripts/test-toolchain-sync.mjs"
            },
            {
              "run": "sh .cip/run-unit.sh"
            }
          ],
          "limits": {
            "timeoutSec": 900,
            "cpus": 2,
            "memoryMb": 2048
          }
        },
        {
          "name": "tools-types",
          "image": "node:22-bookworm-slim",
          "steps": [
            {
              "run": "cd tools && npm ci --ignore-scripts --no-audit --no-fund"
            },
            {
              "run": "cd tools && npm run -s typecheck"
            }
          ],
          "limits": {
            "timeoutSec": 300,
            "cpus": 2,
            "memoryMb": 2048
          }
        },
        {
          "name": "iotroute",
          "image": "rust:1.93.1",
          "steps": [
            {
              "run": "cd tools/router/core && cargo test --release --locked --quiet"
            }
          ],
          "limits": {
            "timeoutSec": 600,
            "cpus": 4,
            "memoryMb": 4096
          }
        },
        {
          "name": "tools-iotroute",
          "image": "rust:1.93.1",
          "steps": [
            {
              "run": "sh .cip/run-iotroute-tests.sh"
            }
          ],
          "limits": {
            "timeoutSec": 600,
            "cpus": 4,
            "memoryMb": 4096
          }
        },
        {
          "name": "pcbsearch",
          "image": "rust:1.93.1",
          "steps": [
            {
              "run": "cd tools/pcb_search/core && cargo test --release --locked --quiet"
            }
          ],
          "limits": {
            "timeoutSec": 600,
            "cpus": 2,
            "memoryMb": 4096
          }
        },
        {
          "name": "studio",
          "image": "node:22-bookworm-slim",
          "steps": [
            {
              "run": "cd apps/studio/app && npm ci --ignore-scripts --no-audit --no-fund"
            },
            {
              "run": "cd apps/studio/app && npm run -s typecheck:node"
            },
            {
              "run": "cd apps/studio/app && ls test/*.test.ts > /dev/null && node --experimental-strip-types --no-warnings --test test/*.test.ts"
            }
          ],
          "limits": {
            "timeoutSec": 600,
            "cpus": 2,
            "memoryMb": 4096
          }
        },
        {
          "name": "job-daemon",
          "image": "node:22-bookworm-slim",
          "steps": [
            {
              "run": "cd apps/job-daemon && npm ci --ignore-scripts --no-audit --no-fund"
            },
            {
              "run": "cd apps/job-daemon && npm run -s typecheck"
            },
            {
              "run": "cd apps/job-daemon && npm test"
            }
          ],
          "limits": {
            "timeoutSec": 300,
            "cpus": 2,
            "memoryMb": 2048
          }
        }
      ]
    }
  ]
}
